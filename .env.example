# ─────────────────────────────────────────────────────────────
# IntelliCrash — Environment Variables
# Copy this to .env and fill in your credentials
# ─────────────────────────────────────────────────────────────

# ── App Settings ─────────────────────────────────────────────
DEBUG=true

# ── Firebase ─────────────────────────────────────────────────
# Set to true after adding firebase_admin_key.json to configs/
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=./configs/firebase_admin_key.json

# ── Twilio (SMS Alerts) ─────────────────────────────────────
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_PHONE=+1234567890
TWILIO_EMERGENCY_CONTACT=+919876543210

# ── Email (Hospital Dispatch) ───────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_alert_email@gmail.com
SENDER_PASSWORD=your_app_password_here
HOSPITAL_EMAIL=hospital_dispatch@example.com

# ── Security & Authentication ────────────────────────────────
SECRET_KEY=change-this-in-production-use-a-strong-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── MQTT Message Broker ──────────────────────────────────────
MQTT_ENABLED=false
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883


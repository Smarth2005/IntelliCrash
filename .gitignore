# ==============================================================================
# Project IntelliCrash — Production .gitignore
# ==============================================================================

# Environment & Secrets 
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Python & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Jupyter & Testing Caches
.ipynb_checkpoints/
.pytest_cache/
.coverage
htmlcov/
catboost_info/

# Next.js & Node.js Dashboard
node_modules/
.next/
out/
dashboard/node_modules/
dashboard/.next/
dashboard/out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Edge Runtime & Video Evidence (Keep repo lightweight)
edge/evidence/*.mp4
Raspberry/evidence/*.mp4
edge/blackbox_queue/*
Raspberry/blackbox_queue/*
*.mp4
*.avi
*.h264
live_readings.csv
edge/live_readings.csv
Raspberry/live_readings.csv

# Large dataset and numpy files exceeding GitHub 100MB limit
*.npy
*.npz
foundational_pipeline/dataset/df.csv
foundational_pipeline/data/

# Local SQLite Database Files (Keep schema, ignore live DB writes) 
*.db
*.db-journal
*.db-wal
*.db-shm
!dashboard/data/schema.sql

# IDEs, Editors & OS Metadata 
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
.gemini/
.claude/

# ── Telegram: ONE bot, two different chats ───────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Emergency contact (family / friend): told that hospitals were requested, and which one accepted.
TELEGRAM_CHAT_ID=
# DRIVER's own Telegram chat: receives the "I'm OK" prompt. Driver sends /start to the bot once; the bot replies
# with the chat id to paste here. (Same value as TELEGRAM_CHAT_ID is fine if driver and contact are the same chat.)
TELEGRAM_DRIVER_CHAT_ID=

# ── People (shown to the hospital and the contact) ───────────────────────────
DRIVER_NAME=
DRIVER_PHONE=+91
DRIVER_BLOOD_GROUP=
EMERGENCY_CONTACT_NAME=
VEHICLE_ID=PB-11-AB-2027

# ── Timing / policy ──────────────────────────────────────────────────────────
DRIVER_RESPONSE_SECONDS=60
HOSPITAL_ACK_SECONDS=90
MAX_HOSPITAL_REQUESTS=3
# Comma list of severities that skip the 60 s wait and go straight to the hospital (e.g. FATAL). Empty = always wait.
IMMEDIATE_DISPATCH_SEVERITIES=
# 1 = also tell the emergency contact when the driver confirmed "I'm OK"
NOTIFY_CONTACT_WHEN_DRIVER_OK=0
# 1 = also phone the driver (Twilio) when the prompt is sent
DRIVER_CALL_ENABLED=0

# Seconds the hospital e-mail waits for the crash video (it also holds the footage AFTER the impact) before sending
VIDEO_WAIT_SECONDS=25

# ── Hospital e-mail (demo: your own address) ─────────────────────────────────
HOSPITAL_EMAIL=
SENDER_EMAIL=
SENDER_PASSWORD=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ── Dashboard link used inside the hospital e-mail (must be reachable from where the hospital opens it) ─────
# Demo: http://<LAPTOP-IP>:3000   (defaults to --dashboard-url)
DASHBOARD_PUBLIC_URL=
# Position used ONLY when the GPS has no fix (indoor demo). Labelled "demo position" in every message. e.g. CSED:
DEMO_LOCATION=30.354867754145726,76.36953790132621

# ── Twilio (optional) ────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
TWILIO_EMERGENCY_CONTACT=
